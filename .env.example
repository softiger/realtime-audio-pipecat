# 必填：阿里云百炼 API Key（北京地域）
DASHSCOPE_API_KEY=sk-xxxxxxxx

# 可选：业务空间 ID；填写后走专属域名 {WorkspaceId}.cn-beijing.maas.aliyuncs.com
DASHSCOPE_WORKSPACE_ID=

# 实时语音模型与音色
REALTIME_MODEL=qwen-audio-3.1-realtime-plus
REALTIME_VOICE=longanqian_v3.1

# 轮次检测：smart_turn_v2 | server_vad | manual
TURN_DETECTION=smart_turn_v2
# 仅 TURN_DETECTION=server_vad 生效
SERVER_VAD_THRESHOLD=0.5
SERVER_VAD_SILENCE_DURATION_MS=500

# 可选：目标说话人声纹预录 URL（公网可访问，16kHz PCM/WAV）
# 仅 smart_turn / smart_turn_v2 生效；逗号分隔，最多 5 个；仅首次 session.update 写入
# VOICEPRINT_AUDIO_URLS=https://example.com/speaker1.pcm,https://example.com/speaker2.wav
VOICEPRINT_AUDIO_URLS=

# 播报/麦：soft(推荐) | full | gate | half
VOICE_DUPLEX=soft

# 播报文案：polish=忠实内容可轻度口语化（默认）| verbatim=完整照读不增删改写
# 同时作用于：工具结果复述 + 开场白/垫词 speak_text
SPEAK_MODE=polish

# 得助等待垫词（工具超过 delay 仍在跑则播）
TOOL_FILLER_ENABLED=true
# 首触延迟（ms）：工具开始后多久仍未返回才播第一句
TOOL_FILLER_DELAY_MS=450
# 多次间隔（ms）：两句之间；<=0 只播首触；需配合 MAX_COUNT>1
TOOL_FILLER_INTERVAL_MS=3000
# 单次工具调用最多垫词句数（含首触）
TOOL_FILLER_MAX_COUNT=1
TOOL_FILLER_TEXT=稍等，我帮您查一下。
# 垫词 conversation user 提示（交给模型的「请播报…」）
TOOL_FILLER_PROMPT=（系统）请播报等待提示。
# 开场/垫词朗读 instructions 前缀；空=内置 polish/verbatim 模板
# SPEAK_PREFIX_POLISH=请用自然亲切的中文口语播报下面内容，可轻度口语化，但不要改变原意、不要反问、不要调用任何工具：
# SPEAK_PREFIX_VERBATIM=请用自然亲切的中文口语完整朗读下面内容，不要增删改写，不要反问，不要调用任何工具：
SPEAK_PREFIX_POLISH=
SPEAK_PREFIX_VERBATIM=
# 调工具前等待本轮转写校准 question（毫秒）
TOOL_TRANSCRIPT_WAIT_MS=550

# 业务 API 超时（毫秒）与兜底话术；response.create 紧贴 cancel 的沉降
TOOL_TIMEOUT_MS=8000
TOOL_FALLBACK_TEXT=查询有点慢，请稍后再试，或换个方式描述您的问题。
RESPONSE_SETTLE_MS=50

# 得助文本应答
DZ_API_BASE_URL=
DZ_APP_ID=
DZ_CHANNEL_ID=
# PKCS#8 私钥（可无头尾，整段 base64 或带 BEGIN PRIVATE KEY）
DZ_PRIVATE_KEY=
# 默认 sha256_pkcs1；老鉴权 sha1_pkcs1；新 PSS 用 pss_sha256
DZ_SIGN_MODE=sha256_pkcs1
DZ_REPLY_PATH=/chat/openapi/v1/chat/reply

# 服务
HOST=0.0.0.0
PORT=8766